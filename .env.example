# Copy this file to .env.local and fill in the values.

# Your Neon connection string (Neon dashboard -> Connect -> copy the "pooled" string)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Any secret word. Open /admin?key=THIS_WORD to see all enquiries.
ADMIN_KEY="change-this-secret"
